# Copie este arquivo para ".env" e preencha os valores.
# O ".env" está no .gitignore e nunca deve ir para o Git.

# --- Geral ---
ASSISTANT_NAME=J.A.R.V.I.S
# Como o assistente chama você: seu nome ou um tratamento formal, como
# "senhor" ou "senhora", para o tom de mordomo. Opcional.
USER_NAME=
PORT=8000
TIMEZONE=America/Sao_Paulo
# Intervalo de atualização automática dos painéis, em segundos
REFRESH_SECONDS=300
# true = painéis usam dados falsos (Fase 1). Integrações reais chegam nas próximas fases.
DEMO_MODE=true

# --- Canvas (Fase 2) ---
CANVAS_BASE_URL=https://puc-campinas.instructure.com
CANVAS_TOKEN=
# Plano B: link do "Feed do calendário" do Canvas (contém um segredo, trate como token)
CANVAS_ICS_URL=

# --- Investimentos (Fase 2) ---
BRAPI_TOKEN=

# --- Google: Gmail e Calendar (Fase 3) ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- IA (Fase 4) ---
GEMINI_API_KEY=
# O modelo será definido na Fase 4, após consultar a documentação atual do plano gratuito
GEMINI_MODEL=
