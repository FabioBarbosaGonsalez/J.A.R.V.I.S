# Copie este arquivo para ".env" e preencha os valores.
# O ".env" está no .gitignore e nunca deve ir para o Git.

# --- Geral ---
ASSISTANT_NAME=J.A.R.V.I.S
# Como o assistente chama você: seu nome ou um tratamento formal, como
# "senhor" ou "senhora", para o tom de mordomo. Opcional.
USER_NAME=
PORT=8000
TIMEZONE=America/Sao_Paulo
# Intervalo de atualização automática dos painéis, em segundos
REFRESH_SECONDS=300
# true = todos os painéis usam dados de demonstração.
# false = dados reais (Canvas e carteira na Fase 2; Gmail e Agenda na Fase 3).
DEMO_MODE=true

# --- Canvas (Fase 2) ---
# Configure o token, o feed ou os dois. Se o token faltar ou falhar, o feed é usado.
CANVAS_BASE_URL=https://puc-campinas.instructure.com
# Conta > Configurações > "+ Novo token de acesso" (defina uma data de validade)
CANVAS_TOKEN=
# Plano B: Calendário > "Feed do calendário". O link contém um segredo: trate como token.
CANVAS_ICS_URL=

# --- Investimentos (Fase 2) ---
# Sua carteira fica em data/carteira.csv (modelo: data/carteira.example.csv)
# Cotações da B3 e dos EUA: token gratuito em https://brapi.dev/dashboard
# O dólar vem da AwesomeAPI, que não precisa de chave.
BRAPI_TOKEN=
# Plano gratuito: 1 ativo por requisição (Startup: 10; Pro: 20)
BRAPI_TICKERS_PER_REQUEST=1

# --- Google: Gmail e Calendar (Fase 3) ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- IA (Fase 4) ---
GEMINI_API_KEY=
# O modelo será definido na Fase 4, após consultar a documentação atual do plano gratuito
GEMINI_MODEL=
